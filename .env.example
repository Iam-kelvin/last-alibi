# Optional analytics. The app runs fully without these values.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional crash reporting. Leave blank for local/offline builds.
EXPO_PUBLIC_SENTRY_DSN=

# Optional Sentry source-map upload values for release builds.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Native builds without all three upload values must skip source-map upload.
SENTRY_DISABLE_AUTO_UPLOAD=true
